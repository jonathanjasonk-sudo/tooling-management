# Salin menjadi .env (lokal) — di Railway isi lewat tab Variables
# DATABASE_URL otomatis diisi Railway bila memakai plugin PostgreSQL.
# Jika kosong, aplikasi memakai database lokal di folder .data (untuk coba-coba di komputer sendiri).
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Password untuk masuk ke dashboard. Kosongkan = tanpa login (JANGAN begitu di internet).
APP_PASSWORD=ganti-password-ini

# Teks acak panjang untuk menandatangani sesi login (opsional tapi disarankan)
SESSION_SECRET=
